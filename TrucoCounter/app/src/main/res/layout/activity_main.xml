<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_label_jogador_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="Jogador 1:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_pontuacao_jogador_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textAppearance="@android:style/TextAppearance.Large"
        app:layout_constraintBottom_toBottomOf="@+id/tv_label_jogador_1"
        app:layout_constraintStart_toEndOf="@+id/tv_label_jogador_1"
        app:layout_constraintTop_toTopOf="@+id/tv_label_jogador_1"
        tools:text="00" />

    <Button
        android:id="@+id/btn_jogador_1_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginTop="16dp"
        android:text="+1"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_1_3"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_label_jogador_1" />

    <Button
        android:id="@+id/btn_jogador_1_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:text="+3"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_1_1"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_1_6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_1_1"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_1_1" />

    <Button
        android:id="@+id/btn_jogador_1_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:text="+6"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_1_3"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_1_9"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_1_3"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_1_3" />

    <Button
        android:id="@+id/btn_jogador_1_9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:text="+9"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_1_6"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_1_12"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_1_6"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_1_6" />

    <Button
        android:id="@+id/btn_jogador_1_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:gravity="center"
        android:singleLine="true"
        android:text="+12"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_1_9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_1_9"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_1_9" />

    <TextView
        android:id="@+id/tv_label_jogador_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="Jogador 2:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_jogador_1_1" />

    <TextView
        android:id="@+id/tv_pontuacao_jogador_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textAppearance="@android:style/TextAppearance.Large"
        app:layout_constraintBottom_toBottomOf="@+id/tv_label_jogador_2"
        app:layout_constraintStart_toEndOf="@+id/tv_label_jogador_2"
        app:layout_constraintTop_toTopOf="@+id/tv_label_jogador_2"
        tools:text="00" />

    <Button
        android:id="@+id/btn_jogador_2_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginTop="16dp"
        android:text="+1"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_2_3"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_label_jogador_2" />

    <Button
        android:id="@+id/btn_jogador_2_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:text="+3"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_2_1"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_2_6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_2_1"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_2_1" />

    <Button
        android:id="@+id/btn_jogador_2_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:text="+6"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_2_3"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_2_9"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_2_3"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_2_3" />

    <Button
        android:id="@+id/btn_jogador_2_9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:text="+9"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_2_6"
        app:layout_constraintEnd_toStartOf="@id/btn_jogador_2_12"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_2_6"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_2_6" />

    <Button
        android:id="@+id/btn_jogador_2_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:gravity="center"
        android:singleLine="true"
        android:text="+12"
        app:layout_constraintBottom_toBottomOf="@id/btn_jogador_2_9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btn_jogador_2_9"
        app:layout_constraintTop_toTopOf="@id/btn_jogador_2_9" />

    <Button
        android:id="@+id/btn_historico_de_jogadas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="4dp"
        android:text="Histórico de Jogadas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_jogador_2_1" />

    <Button
        android:id="@+id/btn_zerar_historico_de_jogadas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Zerar Histórico"
        app:layout_constraintEnd_toEndOf="@id/btn_historico_de_jogadas"
        app:layout_constraintStart_toStartOf="@id/btn_historico_de_jogadas"
        app:layout_constraintTop_toBottomOf="@id/btn_historico_de_jogadas" />

    <Button
        android:id="@+id/btn_informar_nomes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Informar Nomes"
        app:layout_constraintEnd_toEndOf="@id/btn_zerar_historico_de_jogadas"
        app:layout_constraintStart_toStartOf="@id/btn_zerar_historico_de_jogadas"
        app:layout_constraintTop_toBottomOf="@id/btn_zerar_historico_de_jogadas" />


</androidx.constraintlayout.widget.ConstraintLayout>