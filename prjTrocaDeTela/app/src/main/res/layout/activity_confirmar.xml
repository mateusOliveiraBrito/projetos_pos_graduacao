<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmarActivity">

    <TextView
        android:id="@+id/txtCodigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Cód"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCodigoValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        tools:text="00"
        app:layout_constraintStart_toEndOf="@id/txtCodigo"
        app:layout_constraintTop_toTopOf="@id/txtCodigo" />

    <TextView
        android:id="@+id/txtQuantidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Qtd"
        app:layout_constraintEnd_toEndOf="@id/txtCodigo"
        app:layout_constraintStart_toStartOf="@id/txtCodigo"
        app:layout_constraintTop_toBottomOf="@id/txtCodigo" />

    <TextView
        android:id="@+id/txtQuantidadeValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        tools:text="00"
        app:layout_constraintStart_toEndOf="@id/txtQuantidade"
        app:layout_constraintTop_toTopOf="@id/txtQuantidade" />

    <TextView
        android:id="@+id/txtValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Valor"
        app:layout_constraintEnd_toEndOf="@id/txtQuantidade"
        app:layout_constraintStart_toStartOf="@id/txtQuantidade"
        app:layout_constraintTop_toBottomOf="@id/txtQuantidade" />

    <TextView
        android:id="@+id/txtValorValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        tools:text="00"
        app:layout_constraintStart_toEndOf="@id/txtValor"
        app:layout_constraintTop_toTopOf="@id/txtValor" />

    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/txtValor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Enviar" />

</androidx.constraintlayout.widget.ConstraintLayout>