<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtPeso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Peso:"
        app:layout_constraintBottom_toBottomOf="@id/edTxtPeso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edTxtPeso" />

    <EditText
        android:id="@+id/edTxtPeso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Peso em kg"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtPeso"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtAltura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Altura:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edTxtAltura"
        app:layout_constraintBottom_toBottomOf="@id/edTxtAltura"
        app:layout_constraintTop_toBottomOf="@id/txtPeso" />

    <EditText
        android:id="@+id/edTxtAltura"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Altura em m"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/edTxtPeso"
        app:layout_constraintTop_toBottomOf="@id/edTxtPeso" />

    <TextView
        android:id="@+id/txtIMC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="IMC:"
        app:layout_constraintStart_toStartOf="@id/txtPeso"
        app:layout_constraintTop_toTopOf="@id/txtResultado"
        app:layout_constraintBottom_toBottomOf="@id/txtResultado"/>

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="0.0"
        android:textAppearance="@android:style/TextAppearance.Large"
        app:layout_constraintStart_toStartOf="@id/edTxtPeso"
        app:layout_constraintTop_toBottomOf="@id/txtAltura" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="Calcular"
        app:layout_constraintEnd_toStartOf="@id/btnLimpar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtIMC" />

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="Limpar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnCalcular"
        app:layout_constraintTop_toBottomOf="@id/txtIMC" />
</androidx.constraintlayout.widget.ConstraintLayout>